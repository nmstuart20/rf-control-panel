{
  "hardware_checks": {
    "Signal Hound VSG60A": {"type": "signalhound", "timeout": 5},
    "Example modem": {"type": "tcp", "host": "192.0.2.10", "port": 80, "timeout": 3}
  },
  "scenarios": [
    {
      "id": "vsg-stepped-1ghz",
      "name": "Stepped sweep",
      "description": "201-point stepped sweep with adjustable frequency, span, sample rate, and output level.",
      "equipment": ["Signal Hound VSG60A"],
      "arguments": [
        {"id": "center", "label": "Center frequency", "type": "number", "default": 1000000000, "min": 50000000, "max": 6000000000, "step": 1000000, "unit": "Hz"},
        {"id": "span", "label": "Span", "type": "number", "default": 200000000, "min": 1000000, "max": 5950000000, "step": 1000000, "unit": "Hz"},
        {"id": "sample_rate", "label": "Sample rate", "type": "number", "default": 50000000, "min": 1000000, "max": 100000000, "step": 1000000, "unit": "S/s"},
        {"id": "level", "label": "Output level", "type": "number", "default": -20, "min": -60, "max": 20, "step": 1, "unit": "dBm"}
      ],
      "steps": [
        {
          "name": "Generate stepped sweep",
          "command": ["python3", "-u", "sweep.py", "--mode", "stepped", "--center", "{center}", "--span", "{span}", "--sample-rate", "{sample_rate}", "--level", "{level}", "--points", "201", "--dwell", "0.005"]
        }
      ]
    },
    {
      "id": "example-modem-setup",
      "name": "Example modem setup",
      "description": "Placeholder sequence that checks a modem, applies a test profile, and enables transmission.",
      "equipment": ["Example modem"],
      "steps": [
        {
          "name": "Check modem status",
          "command": ["./modem_control.sh", "status"]
        },
        {
          "name": "Apply test profile",
          "command": ["./modem_control.sh", "set-profile", "lab-test"]
        },
        {
          "name": "Enable modem transmitter",
          "command": ["./modem_control.sh", "enable-transmit"]
        }
      ]
    }
  ]
}

{
  "hardware_checks": {
    "Signal Hound VSG60A": {"type": "signalhound", "timeout": 10},
    "Quintech switch": {"type": "tcp", "host": "192.168.0.248", "port": 443, "timeout": 10},
    "Example modem": {"type": "tcp", "host": "192.0.2.10", "port": 80, "timeout": 10}
  },
  "scenarios": [
    {
      "id": "vsg-variable-power-cw",
      "name": "Variable-power CW",
      "equipment": ["Signal Hound VSG60A"],
      "arguments": [
        {"id": "frequency", "label": "Carrier frequency", "type": "number", "default": 1000000000, "min": 30000000, "max": 6000000000, "step": 1000000, "unit": "Hz"},
        {"id": "min_level", "label": "Minimum power", "type": "number", "default": -35, "min": -120, "max": 9, "step": 1, "unit": "dBm"},
        {"id": "max_level", "label": "Maximum power", "type": "number", "default": -15, "min": -119, "max": 10, "step": 1, "unit": "dBm"},
        {"id": "max_step", "label": "Maximum power step", "type": "number", "default": 3, "min": 0.1, "max": 20, "step": 0.1, "unit": "dB"},
        {"id": "interval", "label": "Change interval", "type": "number", "default": 0.5, "min": 0.05, "max": 60, "step": 0.05, "unit": "s"},
        {"id": "duration", "label": "Duration", "type": "number", "default": 30, "min": 1, "max": 3600, "step": 1, "unit": "s"}
      ],
      "steps": [
        {
          "name": "Transmit variable-power CW",
          "command": ["python3", "-u", "-m", "src.signalhound.variable_power", "--frequency", "{frequency}", "--min-level", "{min_level}", "--max-level", "{max_level}", "--max-step", "{max_step}", "--interval", "{interval}", "--duration", "{duration}"]
        }
      ]
    },
    {
      "id": "vsg-stepped",
      "name": "Stepped sweep",
      "equipment": ["Signal Hound VSG60A"],
      "arguments": [
        {"id": "center", "label": "Center frequency", "type": "number", "default": 1000000000, "min": 50000000, "max": 6000000000, "step": 1000000, "unit": "Hz"},
        {"id": "span", "label": "Span", "type": "number", "default": 200000000, "min": 1000000, "max": 5950000000, "step": 1000000, "unit": "Hz"},
        {"id": "sample_rate", "label": "Sample rate", "type": "number", "default": 50000000, "min": 1000000, "max": 100000000, "step": 1000000, "unit": "S/s"},
        {"id": "level", "label": "Output level", "type": "number", "default": -20, "min": -60, "max": 20, "step": 1, "unit": "dBm"}
      ],
      "steps": [
        {
          "name": "Generate stepped sweep",
          "command": ["python3", "-u", "-m", "src.signalhound.sweep", "--mode", "stepped", "--center", "{center}", "--span", "{span}", "--sample-rate", "{sample_rate}", "--level", "{level}", "--points", "201", "--dwell", "0.005"]
        }
      ]
    },
    {
      "id": "dual-vsg-collision",
      "name": "Two-signal collision",
      "description": "Combine two CW signals from separate Signal Hound generators on Quintech fan-in output 1.",
      "equipment": ["Signal Hound VSG60A", "Quintech switch"],
      "arguments": [
        {"id": "frequency_1", "label": "Signal 1 frequency", "type": "number", "default": 1000000000, "min": 30000000, "max": 6000000000, "step": 1000000, "unit": "Hz"},
        {"id": "frequency_2", "label": "Signal 2 frequency", "type": "number", "default": 1010000000, "min": 30000000, "max": 6000000000, "step": 1000000, "unit": "Hz"},
        {"id": "level_1", "label": "Signal 1 power", "type": "number", "default": -20, "min": -120, "max": 10, "step": 1, "unit": "dBm"},
        {"id": "level_2", "label": "Signal 2 power", "type": "number", "default": -20, "min": -120, "max": 10, "step": 1, "unit": "dBm"},
        {"id": "duration", "label": "Duration", "type": "number", "default": 30, "min": 1, "max": 3600, "step": 1, "unit": "s"}
      ],
      "steps": [
        {
          "name": "Connect fan-in output 1 to inputs 1 and 2",
          "command": ["python3", "-u", "-m", "src.quintech.fanin_connect", "1", "1", "2"]
        },
        {
          "name": "Transmit both colliding signals",
          "command": ["python3", "-u", "-m", "src.signalhound.dual_cw", "--frequency-1", "{frequency_1}", "--frequency-2", "{frequency_2}", "--level-1", "{level_1}", "--level-2", "{level_2}", "--duration", "{duration}"]
        }
      ]
    },
    {
      "id": "example-modem-setup",
      "name": "Example modem setup",
      "equipment": ["Example modem"],
      "steps": [
        {
          "name": "Check modem status",
          "command": ["./modem_control.sh", "status"]
        },
        {
          "name": "Apply test profile",
          "command": ["./modem_control.sh", "set-profile", "lab-test"]
        },
        {
          "name": "Enable modem transmitter",
          "command": ["./modem_control.sh", "enable-transmit"]
        }
      ]
    }
  ]
}
